{
  "name": "robert-gym-backend",
  "version": "1.0.0",
  "description": "API REST para Robert Gym - Club Fitness, Arequipa",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql -U postgres -d robertgym -f src/db/schema.sql",
    "test": "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/validaciones.js",
      "src/middleware/auth.js",
      "src/middleware/errorHandler.js",
      "src/controllers/asistencia.controller.js",
      "src/controllers/pagos.controller.js",
      "src/controllers/auth.controller.js",
      "src/controllers/reportes.controller.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
